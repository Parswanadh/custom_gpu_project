{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bitbybit/benchmark-compare-summary/v1",
  "title": "BitbyBit Compare Summary Schema",
  "description": "Schema contract for sim/compare_summary_latest.json generated by scripts/demo_day.ps1",
  "type": "object",
  "required": [
    "benchmark_version",
    "benchmark_frequency_hz",
    "script",
    "generated_utc",
    "run_id",
    "workload_mode",
    "workload_count_requested",
    "workload_count_effective",
    "warmup_runs",
    "measured_runs",
    "workloads",
    "samples",
    "stats",
    "run_quality",
    "system_environment",
    "file_integrity"
  ],
  "properties": {
    "benchmark_version": { "type": "string", "minLength": 1 },
    "benchmark_frequency_hz": { "type": "integer", "minimum": 1 },
    "script": { "type": "string", "minLength": 1 },
    "generated_utc": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "workload_mode": { "type": "string", "enum": ["single", "matrix"] },
    "workload_generation": { "type": "string" },
    "workload_seed": { "type": "integer" },
    "workload_count_requested": { "type": "integer", "minimum": 1 },
    "workload_count_effective": { "type": "integer", "minimum": 1 },
    "token_space": { "type": "integer", "minimum": 1 },
    "position_space": { "type": "integer", "minimum": 1 },
    "token_id": { "type": ["integer", "null"] },
    "position": { "type": ["integer", "null"] },
    "warmup_runs": { "type": "integer", "minimum": 0 },
    "measured_runs": { "type": "integer", "minimum": 1 },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["TokenId", "Position"],
        "properties": {
          "TokenId": { "type": "integer", "minimum": 0 },
          "Position": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workload_index",
          "run_index",
          "phase",
          "token_id",
          "position",
          "base_cycles",
          "imprint_cycles",
          "base_tokens_per_second",
          "imprint_tokens_per_second",
          "base_medusa_toks",
          "imprint_medusa_toks",
          "speedup_x"
        ],
        "properties": {
          "workload_index": { "type": "integer", "minimum": 1 },
          "run_index": { "type": "integer", "minimum": 1 },
          "phase": { "type": "string", "enum": ["measured"] },
          "token_id": { "type": "integer", "minimum": 0 },
          "position": { "type": "integer", "minimum": 0 },
          "base_cycles": { "type": "number", "exclusiveMinimum": 0 },
          "imprint_cycles": { "type": "number", "exclusiveMinimum": 0 },
          "base_tokens_per_second": { "type": "number", "exclusiveMinimum": 0 },
          "imprint_tokens_per_second": { "type": "number", "exclusiveMinimum": 0 },
          "base_medusa_toks": { "type": "number", "exclusiveMinimum": 0 },
          "imprint_medusa_toks": { "type": "number", "exclusiveMinimum": 0 },
          "speedup_x": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "stats": { "type": "object" },
    "run_quality": {
      "type": "object",
      "required": [
        "warmup_meets_recommendation",
        "measured_meets_recommendation",
        "workload_diversity_ok",
        "workload_coverage_pct"
      ],
      "properties": {
        "warmup_meets_recommendation": { "type": "boolean" },
        "measured_meets_recommendation": { "type": "boolean" },
        "workload_diversity_ok": { "type": "boolean" },
        "workload_coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "system_environment": {
      "type": "object",
      "required": [
        "powershell_version",
        "computer_name",
        "processor",
        "iverilog_path",
        "vvp_path"
      ],
      "properties": {
        "powershell_version": { "type": "string", "minLength": 1 },
        "computer_name": { "type": "string", "minLength": 1 },
        "processor": { "type": "string", "minLength": 1 },
        "iverilog_path": { "type": "string", "minLength": 1 },
        "vvp_path": { "type": "string", "minLength": 1 }
      }
    },
    "file_integrity": {
      "type": "object",
      "required": ["top_log_sha256", "base_log_sha256", "imprint_log_sha256"],
      "properties": {
        "top_log_sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "base_log_sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "imprint_log_sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
      }
    }
  }
}